# Local Environment Configuration for MedSSL-BHSD
# Copy to .env (gitignored) for local development, or configure via Kaggle Secrets / HPC env vars.

# Hugging Face Hub Checkpoint Storage
HF_TOKEN=your_hf_write_token_here
HF_REPO_ID=your_username/BHSD_checkpoints

# Weights & Biases Experiment Tracking
WANDB_API_KEY=your_wandb_api_key_here
MEDSSL_WANDB_ENTITY=your_wandb_entity_here

# Local / HPC Paths (optional overrides for configs/base.yaml)
MEDSSL_DATA_ROOT=~/notebook/preprocessed_bhsd_pick/
MEDSSL_EXP_DIR=~/experiments
